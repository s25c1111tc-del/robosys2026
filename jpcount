import sys
import unicodedata

counts = {
    "Kanji": 0,
    "Hiragana": 0,
    "Katakana": 0,
    "Alphabet": 0,
    "Digits": 0,
    "Other": 0,
}

for char in sys.stdin.read():
    if char.isspace():
        continue

    name = unicodedata.name(char, "")

    if "HIRAGANA" in name:
        counts["Hiragana"] += 1
    elif "KATAKANA" in name:
        counts["Katakana"] += 1
    elif "CJK UNIFIED IDEOGRAPH" in name:
        counts["Kanji"] += 1
    elif char.isalpha():
        counts["Alphabet"] += 1
    elif char.isdigit():
        counts["Digits"] += 1
    else:
        counts["Other"] += 1

total = sum(counts.values())

print(f"Non-space characters: {total}")
for category, count in counts.items():
    print(f"{category}: {count}")
